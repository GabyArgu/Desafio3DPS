<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/black_deep"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Eliminar Recurso?"
            android:textColor="@color/pink_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/confirm_delete"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gap="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelarDialog"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="No, volver"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/rounded_input"
                app:backgroundTint="@color/dark_bg"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEliminarDialog"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Sí, borrar"
                android:textAllCaps="false"
                android:textColor="@color/black_deep"
                android:textStyle="bold"
                android:background="@drawable/rounded_input"
                app:backgroundTint="@color/pink_primary"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>